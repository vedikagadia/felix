# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Secrets & local config
.env
# Filled-in ECS task defs (real DATABASE_URL / GEMINI_API_KEY / DUCKDNS_TOKEN).
# The committed deploy/task-def-*.json carry REPLACE_WITH_… placeholders; copy
# one to *.local.json, fill secrets there, and register THAT file.
deploy/*.local.json

# Local single-node CockroachDB data dir
.crdb-data/
*.crt
*.key
certs/

# OS / editor
.DS_Store
.idea/
.vscode/

# Local-only design docs (not pushed)
docs/

# Orchestration scratch (build contracts, agent notes — local only)
.orchestration/

# Scratch test-run captures
live-test-output.txt

# Demo pipeline generated artifacts (regenerable via python -m demo.orchestrate)
demo/out/

# Cached CockroachDB MCP OAuth tokens (local only)
.crdb-mcp-tokens.json
