# Copy to .env.local and set to your felix backend's base URL.
#
# When UNSET, the app runs in MOCK mode — the chat is fully interactive and
# returns canned responses for the two planted puzzles (see src/api/mock.ts),
# so you can develop the UI with no backend running.
#
# When set, the app POSTs to `${VITE_API_URL}/chat` with the contract in
# src/api/types.ts. Example values:
#   VITE_API_URL=http://localhost:8000     # backend on its own port (CORS must allow the dev origin)
#   VITE_API_URL=/api                       # use the Vite dev proxy in vite.config.ts (no CORS)
# VITE_API_URL=http://localhost:8000

# Force mock mode even when VITE_API_URL is set (handy for UI-only work):
# VITE_USE_MOCK=true
