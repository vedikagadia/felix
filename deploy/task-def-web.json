{
  "family": "felix-web",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "512",
  "memory": "4096",
  "executionRoleArn": "arn:aws:iam::287211515912:role/felix-ecs-execution",
  "taskRoleArn": "arn:aws:iam::287211515912:role/felix-ecs-task",
  "containerDefinitions": [
    {
      "name": "felix-web",
      "image": "287211515912.dkr.ecr.us-east-1.amazonaws.com/felix:latest",
      "essential": true,
      "portMappings": [
        { "containerPort": 8000, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "ROLE", "value": "web" },
        { "name": "FELIX_RUN_WATCHER", "value": "1" },
        { "name": "FELIX_RUN_SAMPLE", "value": "1" },
        { "name": "EMBED_PROVIDER", "value": "local" },
        { "name": "LLM_PROVIDER", "value": "gemini" },
        { "name": "DUCKDNS_DOMAIN", "value": "felix-demo" },
        { "name": "FELIX_CLI_ENABLED", "value": "false" },

        { "name": "CRDB_MCP_URL", "value": "https://cockroachlabs.cloud/mcp" },
        { "name": "CRDB_MCP_CLUSTER_ID", "value": "REPLACE_WITH_CRDB_CLUSTER_ID" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:us-east-1:287211515912:secret:felix/DATABASE_URL" },
        { "name": "GEMINI_API_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:287211515912:secret:felix/GEMINI_API_KEY" },
        { "name": "DUCKDNS_TOKEN", "valueFrom": "arn:aws:secretsmanager:us-east-1:287211515912:secret:felix/DUCKDNS_TOKEN" },
        { "name": "CRDB_MCP_API_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:287211515912:secret:felix/CRDB_MCP_API_KEY" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/felix",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "web"
        }
      }
    }
  ]
}
