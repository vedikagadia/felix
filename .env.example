# Copy to .env and fill in. .env is gitignored.

# --- AWS Bedrock ---
AWS_REGION=us-east-1
# Uses your default AWS credential chain (aws configure / SSO / env vars).
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
EMBED_DIM=1024

# --- CockroachDB Cloud ---
# From the Cloud Console "Connect" dialog (Basic cluster).
DATABASE_URL=postgresql://<user>:<password>@<host>:26257/<db>?sslmode=verify-full

# --- CockroachDB Cloud Managed MCP Server ---
# Auth is OAuth (browser flow) — no static token. From the Cloud Console
# "Connect via MCP" dialog you get the endpoint + your cluster id; the cluster
# id rides on every request as the `mcp-cluster-id` header. Authenticate once
# via `claude /mcp` or `python -m src mcp-probe` (opens the OAuth consent).
CRDB_MCP_URL=https://cockroachlabs.cloud/mcp
CRDB_MCP_CLUSTER_ID=<your cluster id, e.g. bea05a4f-...>
# Optional service-account bearer token for headless access; blank = use OAuth.
CRDB_MCP_API_KEY=

# --- LLM reasoning (clients/llm) ---
# "gemini" (default) | "bedrock"
LLM_PROVIDER=gemini
# From https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-flash-latest

# --- Live-monitoring alert levels (optional) ---
# The p99 (ms) a latency metric trips at on the Live monitoring panel. These are
# just the DEFAULTS the panel loads; each card's level is still editable live.
METRIC_ALERT_DEFAULT_P99_MS=1000
# Per-metric overrides as a JSON object of metric name -> p99 ms. Example:
# METRIC_ALERT_THRESHOLDS={"payment_latency_ms": 800, "enqueue_latency_ms": 200}
METRIC_ALERT_THRESHOLDS=
